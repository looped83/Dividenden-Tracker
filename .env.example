# Supabase-Projektzugang (SECURITY_MODEL.md §5).
# VITE_SUPABASE_ANON_KEY ist der oeffentliche Anon/Publishable Key, kein
# Geheimnis (durch Row Level Security geschuetzt). Der Service-Role-Key
# gehoert NIEMALS in diese Datei, das Frontend oder das Repository.
VITE_SUPABASE_URL=https://<projekt>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-key>

# Dividendenkalender (docs/CALENDAR_INTEGRATION.md).
# NUR fuer die lokale Entwicklung der Edge Function:
#   supabase functions serve sync-divvydiary-calendar --env-file .env
# Im Betrieb liegt der Wert ausschliesslich als Supabase-Secret vor
#   supabase secrets set DIVVYDIARY_ICAL_URL="YOUR_PRIVATE_ICAL_URL"
# und wird niemals an den Browser ausgeliefert. Kein VITE_-Praefix: Sonst
# landete der persoenliche Feed-Token im Bundle.
DIVVYDIARY_ICAL_URL=
