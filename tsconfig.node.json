{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "types": ["node", "vitest/config"],

    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  // `scripts/divvydiary-discovery` ist ein Node-Werkzeug ausserhalb der
  // Anwendung (docs/divvydiary-api-discovery.md). Es gehoert hierher, weil es
  // wie `vite.config.ts` Node-Globals nutzt und nicht ins Browser-Bundle geht.
  "include": ["vite.config.ts", "scripts/divvydiary-discovery"]
}
